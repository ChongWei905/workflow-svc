# Skill Executor 配置文件

# ===========================================
# 基础配置
# ===========================================
# Skills 目录路径
skills_dir: ./skills

# LLM 提供商: openai 或 anthropic
provider: openai

# 模型名称 (可选，留空使用默认)
model: deepseek-chat
base_url: https://api.deepseek.com
api_key: sk-3a5d1cb468f74f0db2f6105cad858ce9

# 详细输出模式
verbose: false

# ===========================================
# 实验模式配置 (新增)
# ===========================================
experiment:
  # 系统提示词模式
  # - "skill_creation": 允许创建 Skill (默认)
  # - "direct_query": 直接查询，不创建 Skill
  prompt_mode: skill_creation

# ===========================================
# 图数据库配置
# ===========================================
graph_database:
  enabled: true  # 是否启用图数据库
  base_url: http://localhost:8080  # 图数据库 API 地址
  timeout: 30  # 请求超时(秒)
  cache_enabled: true  # 是否启用查询缓存

# ===========================================
# 安全配置
# ===========================================
security:
  # 审计日志文件路径 (可选)
  audit_log: null

  # 审计级别: none, basic, detailed
  audit_level: basic

  # 是否输出审计日志到控制台
  audit_console: false

  # 最大脚本执行时间（秒）
  max_execution_time: 300

  # 允许执行脚本的路径列表 (可选)
  allowed_paths: []
    # - ./skills
    # - /tmp/safe-scripts

# ===========================================
# LLM API 配置
# ===========================================
# 注意: API 密钥优先从环境变量读取
# OPENAI_API_KEY 或 ANTHROPIC_API_KEY

# 可选: 在配置文件中设置（不推荐，有安全风险）
# api_keys:
#   openai: sk-...
#   anthropic: sk-ant-...