# Skill Executor API - Environment Configuration

# ===========================================
# API Authentication
# ===========================================
# Comma-separated list of valid API keys
# Leave empty to disable authentication (development mode)
API_KEYS=

# ===========================================
# LLM Configuration
# ===========================================
# Default LLM provider (openai or anthropic)
DEFAULT_PROVIDER=openai

# Optional: Override default model
# LLM_MODEL=gpt-4
# LLM_MODEL=claude-3-opus-20240229

# ===========================================
# Skills Configuration
# ===========================================
# Path to skills directory
SKILLS_DIR=./skills

# ===========================================
# Security Configuration
# ===========================================
# Maximum script execution time (seconds)
MAX_EXECUTION_TIME=300

# Audit logging level: none, basic, detailed
AUDIT_LEVEL=basic

# Comma-separated list of allowed script paths (whitelist)
# Leave empty to allow all paths
ALLOWED_PATHS=

# ===========================================
# Server Configuration
# ===========================================
# Server port
PORT=8000

# Server host (0.0.0.0 to listen on all interfaces)
HOST=0.0.0.0

# ===========================================
# OpenAI Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ===========================================
# Anthropic Configuration
# ===========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
